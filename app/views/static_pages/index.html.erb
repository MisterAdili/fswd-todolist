<%= javascript_pack_tag 'index', 'data-turbolinks-track': 'reload' %>

<div class='container'>
  <div class='row'>
    <div class='col-12'>
      <h1 class='text-center mt-4'>To Do List</h1>
    </div>
  </div>
  <div class='row' id='filterTasksRow'>
    <div class='col'>
      <button type='button' class='btn btn-secondary mb-3 filterButton btn-lg active' id='all'>Filter All Tasks</button>
    </div>
    <div class='col'>
      <button type='button' class='btn btn-primary mb-3 filterButton btn-sm' id='inProgress'>Filter Tasks in Progress</button>
    </div>
    <div class='col'>
      <button type='button' class='btn btn-info mb-3 filterButton btn-sm' id='completed'>Filter Tasks Completed</button>
    </div>
  </div>
  <div class='row' id = 'newTaskRow'>
    <div class='col'>
      <input class='form-control mb-3' id='newTaskContent' placeholder='Add a new task'>
    </div>
    <div class='col'>
      <button class='btn btn-secondary mb-3 submitNewTask' id='submitNewTask'>Add Task</button>
    </div>
  </div>
  <div class='row' id='tasks'></div>
</div>